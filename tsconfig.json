{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "styles/**/*.ts",
    "styles/**/*.tsx",
    "data/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
