{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./app-example/*",
        "./*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app-example/**/*.ts",
    "app-example/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "styles/**/*.ts",
    "styles/**/*.tsx",
    "data/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
